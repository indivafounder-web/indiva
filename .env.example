# Turso (libSQL). Leave blank to use a local SQLite file at ./data/indiva.db
TURSO_DATABASE_URL=libsql://YOUR-DB-NAME-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Session signing secret — change in production
JWT_SECRET=replace-with-a-long-random-string

# Public site URL (used in QR passports and emails)
NEXT_PUBLIC_SITE_URL=https://indiva.onrender.com
