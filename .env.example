# ── Session ──────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_SITE_URL=https://indiva.onrender.com

# ── Pick ONE SQL backend ─────────────────────────────────
# The app auto-detects from the URL scheme.
# Priority: DATABASE_URL → TURSO_DATABASE_URL → local file ./data/indiva.db

# 1) Turso (libSQL) — free tier, works on Render
#    turso db create indiva
#    turso db show indiva --url
#    turso db tokens create indiva
TURSO_DATABASE_URL=libsql://YOUR-DB-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# 2) Any PostgreSQL — Render Postgres, Neon, Supabase, Railway, RDS
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/indiva?sslmode=require

# 3) Any MySQL — PlanetScale, Railway, RDS, TiDB
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/indiva

# 4) Local SQLite (default if nothing above is set)
#    no env needed — data/indiva.db
